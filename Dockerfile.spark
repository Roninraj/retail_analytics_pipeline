FROM apache/spark:3.5.0

USER root
RUN apt-get update && apt-get install -y curl && \
    curl -L https://repo1.maven.org/maven2/com/mysql/mysql-connector-j/8.0.33/mysql-connector-j-8.0.33.jar -o /opt/spark/jars/mysql-connector-j-8.0.33.jar

WORKDIR /app
COPY Scripts/spark_analytics.py Scripts/

# Install python dependencies needed for Spark ML and data processing
RUN pip install numpy pandas sqlalchemy pymysql openpyxl

CMD ["/opt/spark/bin/spark-submit", "--jars", "/opt/spark/jars/mysql-connector-j-8.0.33.jar", "Scripts/spark_analytics.py"]
