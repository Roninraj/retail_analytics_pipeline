{
  "version": 2,
  "builds": [
    {
      "src": "vercel_backend.py",
      "use": "@vercel/python"
    },
    {
      "src": "vercel_django.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "vercel_backend.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "vercel_django.py"
    }
  ]
}
